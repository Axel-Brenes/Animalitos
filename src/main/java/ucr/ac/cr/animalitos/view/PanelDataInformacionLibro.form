            <Component class="javax.swing.JTextArea" name="ltxInformacionLibro">
              <Properties>
                <Property name="background" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color blue="e5" green="d5" red="bc" type="rgb"/>
                </Property>
                <Property name="columns" type="int" value="20"/>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Monospaced" size="18" style="1"/>
                </Property>
                <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color blue="3c" green="49" red="60" type="rgb"/>
                </Property>
                <Property name="lineWrap" type="boolean" value="true"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value=" Animalitos es un libro interactivo educativo dise&#xf1;ado para que los ni&#xf1;os aprendan y descubran el fascinante mundo de los animales de una manera divertida, sencilla y din&#xe1;mica. Su prop&#xf3;sito es despertar la curiosidad, fomentar el aprendizaje y promover el respeto y el cuidado de los animales mediante contenidos adaptados para el p&#xfa;blico infantil.                A lo largo del libro, los ni&#xf1;os podr&#xe1;n conocer diferentes tipos de animales, tanto dom&#xe9;sticos como salvajes, descubrir d&#xf3;nde habitan, de qu&#xe9; se alimentan, cu&#xe1;les son sus caracter&#xed;sticas principales y aprender datos curiosos sobre sus comportamientos.                    Estos recursos permiten que los ni&#xf1;os no solo lean y observen, sino que tambi&#xe9;n participen activamente en su aprendizaje mediante ejercicios, preguntas y din&#xe1;micas dise&#xf1;adas para reforzar los conocimientos adquiridos."/>
                <Property name="wrapStyleWord" type="boolean" value="true"/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
      </SubComponents>
